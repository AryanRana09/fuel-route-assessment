# Copy this file to .env and fill in your values.
# Never commit .env to version control.

DJANGO_SECRET_KEY=replace-me-with-a-long-random-string
DJANGO_DEBUG=True

# Free routing API (OpenRouteService)
ROUTING_BASE_URL=https://api.openrouteservice.org

# Nominatim geocoding (OpenStreetMap)
NOMINATIM_URL=https://nominatim.openstreetmap.org

# Must be a unique identifier per ORS / Nominatim policy (e.g. your app name + email)
USER_AGENT=fuel-assessment/1.0 (your@email.com)

# OpenRouteService free API key – get one at https://openrouteservice.org/dev/#/signup
ORS_API_KEY=replace-me
